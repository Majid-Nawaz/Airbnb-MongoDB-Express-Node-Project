<%- layout("layouts/boilerplate") %> <!--This means you say layout() to send all the html below to the layouts/boilerplate.ejs, and boilerplate receives the tag that you specified there form this html, in this case body-->

<body>
    <form method="post" action="/listings">
        <input type="text" name="details[title]" placeholder="Title"><br><br>
        <textarea rows="15" cols="20" type="text" name="details[description]" placeholder="Description"></textarea><br><br>
        <input type="number" name="details[price]" placeholder="Price"><br><br>
        <input type="text" name="details[location]" placeholder="Location"><br><br>
        <button>Submit</button>
    </form>
</body>
